pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    environment {
        REGISTRY = 'host.docker.internal:8082'
        IMAGE_NAME = 'transitdata'
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests -Dspring.profiles.active=deploy'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Create and save release') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$NEXUS_PASSWORD" | docker login "$REGISTRY" \
                            -u "$NEXUS_USER" --password-stdin

                        # Tag the current build for Nexus
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} \
                            ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}

                        # Tag the same image as latest
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} \
                            ${REGISTRY}/${IMAGE_NAME}:latest

                        # Push both tags
                        docker push ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${REGISTRY}/${IMAGE_NAME}:latest

                        docker logout "$REGISTRY"

                        # Remove pipeline-created local tags
                        docker rmi \
                            ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER} \
                            ${REGISTRY}/${IMAGE_NAME}:latest \
                            ${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        success {
            emailext(
                subject: "Build Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Good news. Your build was successfully released.
                Job: ${env.JOB_NAME}
                Build: ${env.BUILD_NUMBER}
                Image: ${env.REGISTRY}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}
                Dev URL: ${env.BUILD_URL}",
                to: "56frankwu@gmail.com"
            )
        }

        failure {
            emailext(
                subject: "Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Your build failed.
                Check details here: ${env.BUILD_URL}",
                to: "56frankwu@gmail.com"
            )
        }
    }
}